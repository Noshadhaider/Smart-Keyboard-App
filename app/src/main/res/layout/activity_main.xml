<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#EEF1F0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Keyboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#10151C"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setup mein 2 steps hain:"
        android:textSize="15sp"
        android:textColor="#6B756F"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEnableKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Keyboard ko Enable karo (Settings)"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSwitchKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Smart Keyboard select karo" />

</LinearLayout>
